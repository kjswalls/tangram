# Live AI answers. Absent -> FakeProvider (offline dictionary mode).
ANTHROPIC_API_KEY=
# fake | anthropic
# AnthropicProvider is selected only when this is `anthropic` AND a key is set;
# either half missing falls back to the fake (lib/ai/provider.ts).
TANGRAM_LLM_PROVIDER=fake
# Model id used by AnthropicProvider; empty -> claude-opus-5 (lib/ai/anthropic.ts,
# DEFAULT_MODEL). Use the bare id, never a date-suffixed variant.
TANGRAM_MODEL=
# Where dict.json / decomp.json live. Empty -> <repo>/data.
TANGRAM_DATA_DIR=

# --- Deployment (docs/deploy.md) ---
# Shared secret that gates the three routes which spend money on the model:
# /api/ask, /api/examples, /api/recall. LEAVE IT EMPTY LOCALLY — with no value
# the gate does not exist and the app, the tests and `pnpm e2e` behave exactly
# as they always have. Set it in Vercel (alongside ANTHROPIC_API_KEY) and
# authorise a device once by visiting https://<app>/?key=<secret>; the cookie it
# leaves behind lasts a year. URL-safe characters only ([A-Za-z0-9._~-]) — the
# cookie carries the value verbatim. Rotating it logs every device out at once.
#   openssl rand -base64 24 | tr '+/' '-_' | tr -d '='
TANGRAM_ACCESS_SECRET=

# --- The server, apps/server (docs/plans/backend.md B0) ---
# The port the SERVER listens on. Empty -> 8787.
#
# Deliberately NOT `PORT` here: `PORT` is already the app's, read by
# apps/app/playwright.config.ts, scripts/preview.ts and scripts/smoke.ts, and
# documented in CLAUDE.md as the e2e port (default 3000). Exporting PORT=8787
# from this file would move `pnpm e2e` onto the API server. The server still
# falls back to PORT when this is unset, so a host that injects only PORT works.
# An unparseable value is a hard failure at boot rather than a silent fall back:
# a service on the wrong port looks healthy locally and is unreachable in the
# deployment.
TANGRAM_SERVER_PORT=
# The interface to bind. Empty -> 0.0.0.0, which is what a container needs.
# Set 127.0.0.1 for local work; 0.0.0.0 on a laptop is every interface.
HOST=
# `development` or `test` enables developer conveniences — notably the error
# message in a 500 body. ANYTHING ELSE, INCLUDING UNSET, IS PRODUCTION, which is
# the safe direction: most hosts inject nothing, and an error from the driver or
# the model SDK routinely carries a connection target. TANGRAM_EXPOSE_ERRORS=1
# is the explicit opt-in when NODE_ENV is not yours to set.
NODE_ENV=
TANGRAM_EXPOSE_ERRORS=
# How long SIGTERM waits for in-flight requests before cutting them. Empty ->
# 35000, comfortably past the 30 s ask deadline. A forced exit logs and exits 75.
TANGRAM_DRAIN_MS=
# The git sha `/health` reports. Normally written into dist/build-info.json by
# `pnpm -F server build`; set this only on a host that builds from an archive
# with no .git of its own.
TANGRAM_BUILD_SHA=

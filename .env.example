# Live AI answers. Absent -> FakeProvider (offline dictionary mode).
ANTHROPIC_API_KEY=
# fake | anthropic
# AnthropicProvider is selected only when this is `anthropic` AND a key is set;
# either half missing falls back to the fake (lib/ai/provider.ts).
TANGRAM_LLM_PROVIDER=fake
# Model id used by AnthropicProvider; empty -> claude-opus-5 (lib/ai/anthropic.ts,
# DEFAULT_MODEL). Use the bare id, never a date-suffixed variant.
TANGRAM_MODEL=
# Where dict.json / decomp.json live. Empty -> <repo>/data.
TANGRAM_DATA_DIR=

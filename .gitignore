node_modules/
.next/
out/
dist/
.cache/
*.tsbuildinfo
next-env.d.ts

# Generated by `pnpm data` — the licence texts beside them are committed.
#
# Deliberately anchored to the WORKSPACE root: `data/` lives here and nowhere
# else (docs/plans/wave-zero.md §1). If a path regression ever makes the build
# write `apps/app/data/`, this pattern does NOT match it and `git status` offers
# 35 MB of untracked JSON — which is the loudest cheap alarm available for a
# failure whose other symptom is that everything passes.
/data/*.json
/data/*.sqlite
# The builder writes `<artifact>.sqlite.tmp-<pid>` and renames it into place, so
# an interrupted `pnpm data` leaves a 43 MB binary behind that the rule above
# does not match. A stale temp file is dead weight, never something to commit.
/data/*.sqlite.tmp-*
/data/raw/

# `data/dict-manifest.json` is covered by the rule above and stays ignored
# deliberately: it is a content hash of a generated file, and committing a hash
# of something nobody has generated is a stale fact waiting to happen.

# Generated by `pnpm sw` from scripts/sw.template.js, stamped with the build id.
apps/app/public/sw.js

# Copied into the app tree by `pnpm dict:copy` (docs/plans/web.md W2), which the
# app's build runs before `vite build` so that `pnpm dev` and `pnpm preview`
# serve them out of `public/` the way the deployed host serves them out of
# `dist/`. 43 MB of generated binary plus its ~17 MB brotli sibling; `pnpm data`
# is the only thing that may produce the originals, at the workspace root.
apps/app/public/dict-*.sqlite
apps/app/public/dict-*.sqlite.br
apps/app/public/dict-*.sqlite.br.json
apps/app/public/dict-*.tmp-*
apps/app/public/dict-manifest.json
apps/app/public/decomp.json

.env*.local
.DS_Store

test-results/
playwright-report/
blob-report/
.playwright/

# Throwaway server logs from a local run or a review agent; never committed.
*.log

# Vendored font binaries (`pnpm font:fetch`, docs/plans/core.md C0). Megabytes,
# fetchable, and pinned by sha256 in scripts/fonts.ts — so the bytes are ignored
# and the OFL licence texts beside them are COMMITTED, the way
# data/COPYING-makemeahanzi is. The OFL requires the licence to travel with the
# font; a gitignore that swallowed it would be a licence bug, not tidiness.
/vendor/fonts/**
!/vendor/fonts/**/
!/vendor/fonts/**/*.txt

# A second, throwaway production build made by
# apps/app/tests/e2e/core/gallery-excluded.spec.ts, which removes it again. A
# crashed run leaves it behind; it is never something to commit.
apps/app/dist-prod-check/
apps/app/dist-e2e-check/

# The gated build `apps/app/tests/e2e/d/access-gate.spec.ts` makes so the
# `?key=` exchange can probe an API that actually refuses a wrong key
# (docs/plans/backend.md B1). Same shape as the two above: throwaway, and never
# something to commit.
apps/app/dist-gated/

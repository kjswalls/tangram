# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 in .gitignore file.
.idea/caches
.idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml

# Keystore files
# UNCOMMENTED DELIBERATELY (docs/plans/android.md A1, A7). The template ships
# these commented out; a signing key committed once is committed forever, and
# A7 is the phase that creates one. The ignore must exist before the file does.
*.jks
*.keystore
keystore.properties

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

# Cordova plugins for Capacitor
capacitor-cordova-android-plugins

# Copied web assets. `cap sync` writes `dist/` into here, and the dictionary
# rides along inside it: @capacitor-community/sqlite 8.1.1 reads its assets from
# `public/assets/databases` (android/src/main/java/.../SQLite/UtilsFile.java:77),
# which is `dist/assets/databases/` on the web side. So the 43 MB artifact A5
# copies is already covered by this one line — but only if the copy goes where
# the plugin looks. The two rules below are the belt for the braces: a copy made
# straight into the asset ROOT, which android.md A5 currently tells a builder to
# do, would land outside `public/` and be committed.
app/src/main/assets/public

# Generated data artifacts, wherever under the asset root they land
# (docs/plans/android.md A1, A5). Never source; always `pnpm data`'s output.
app/src/main/assets/**/*.sqlite
app/src/main/assets/**/*.db
app/src/main/assets/**/decomp.json

# Generated Config files
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json
app/src/main/res/xml/config.xml

# Generated Gradle wiring — NOT in Capacitor's own template gitignore, and it
# has to be here in this workspace (docs/plans/android.md A1).
#
# Both files open with "DO NOT EDIT THIS FILE! IT IS GENERATED EACH TIME
# 'capacitor update' IS RUN", and `capacitor.settings.gradle` embeds pnpm
# virtual-store paths out of the installed tree — relative to the file, but
# naming the store layout:
#
#   project(':capacitor-android').projectDir = new File(
#     '../../../node_modules/.pnpm/@capacitor+android@8.5.2_@capacitor+core@8.5.2/node_modules/@capacitor/android/capacitor')
#
# That is pnpm's content-addressed layout, peer-dependency hash and all. It
# changes whenever a version or a peer resolution does, so committing it commits
# a path that goes stale silently — and `git status` would then be dirty after
# any sync that follows a dependency or peer-resolution change, which is A1's
# criterion 8. (A sync with the tree unchanged rewrites them byte-identically, so
# the everyday case is clean either way; the failure is the upgrade, which is
# exactly when nobody is looking at this file.) The cost is stated rather than
# hidden: a fresh clone must run `pnpm android:sync` before Android Studio can
# open the project, which is criterion 2's documented command anyway.
capacitor.settings.gradle
app/capacitor.build.gradle

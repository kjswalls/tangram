    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "pinyin-pro": "^3.29.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-fsrs": "5.4.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",

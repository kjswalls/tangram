{
  "name": "tangram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "pnpm -F app dev",
    "build": "pnpm run typecheck && pnpm run data:ensure && pnpm -F app build",
    "lint": "eslint . && pnpm -F app lint",
    "typecheck": "tsc --noEmit && pnpm -F app typecheck",
    "test": "pnpm -F app test",
    "e2e": "pnpm -F app e2e",
    "data": "TANGRAM_DATA_DIR=\"$PWD/data\" tsx scripts/build-data.ts",
    "data:ensure": "TANGRAM_DATA_DIR=\"$PWD/data\" tsx scripts/build-data.ts --ensure",
    "data:verify": "TANGRAM_DATA_DIR=\"$PWD/data\" tsx scripts/verify-data.ts",
    "sw": "tsx scripts/build-sw.ts",
    "smoke": "tsx scripts/smoke.ts",
    "preview": "tsx scripts/preview.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "cedict-json": "1.3.20251213",
    "eslint": "^9.39.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0"
  }
}
